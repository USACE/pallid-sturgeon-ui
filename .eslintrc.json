{
  "ignorePatterns": ["vite.config.mjs"],
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react"],
  "parser": "@typescript-eslint/parser",
  "rules": {
    "semi": "warn",
    "no-extra-semi": "warn",
    "no-use-before-define": 2,
    "quotes": [
      "warn",
      "single",
      {
        "avoidEscape": true
      }
    ],
    "jsx-quotes": ["warn", "prefer-single"],
    "arrow-body-style": ["warn", "as-needed"],
    "indent": [
      "warn",
      2,
      {
        "VariableDeclarator": "first",
        "SwitchCase": 1
      }
    ]
  }
}
